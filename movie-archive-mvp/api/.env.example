# Example environment variables for the API
# Copy this file to `.env` in the same folder and edit if necessary.
# PostgreSQL (matches docker-compose.yml in the repo)
DATABASE_URL="postgres://postgres:postgres@localhost:5433/movies"

# Port the API will listen on (optional, default in code is 4000)
PORT=4000

# Set to 'production' in production deployments
# NODE_ENV=development
