# API runtime configuration
# Use postgres service name as hostname when running inside Docker Compose.
DATABASE_URL="postgresql://postgres:change-me-strong-password@postgres:5432/movies"

# API listen port inside the container
PORT=4000

# Runtime mode
NODE_ENV=production

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="https://carrotspops.mov"

# Leave false in production. In development it defaults to true if unset.
ENABLE_DEMO_USERS=false
